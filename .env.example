# OR-Intern Environment Variables
#
# This file contains ONLY secrets and API keys.
# For structured configuration (model selection, solver defaults, messaging, etc.),
# see `config.example.yaml` and copy it to `config.yaml`.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ============================================================================
# Required: LLM API Key
# ============================================================================
# The API key for your LLM provider (OpenAI, Anthropic, or compatible endpoint).
OPENAI_API_KEY=your-api-key-here

# ============================================================================
# Optional: Provider-specific keys
# ============================================================================
# Uncomment and fill in if using Anthropic models directly:
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================================================
# Optional: API endpoint overrides
# ============================================================================
# Custom base URL for OpenAI-compatible endpoints.
# If set, all openai/* models will use this endpoint instead of the default.
# Example: https://api.openai.com/v1
# OPENAI_API_BASE=

# ============================================================================
# Optional: Config file path override
# ============================================================================
# Explicit path to config.yaml (default: ./config.yaml or ~/.config/or-intern/config.yaml)
# OR_INTERN_CONFIG=/path/to/config.yaml

# ============================================================================
# Optional: Runtime overrides (take precedence over config.yaml)
# ============================================================================
# Override model name from config.yaml:
# OR_INTERN_MODEL=openai/gpt-4o

# Override max iterations from config.yaml:
# OR_INTERN_MAX_ITERATIONS=500

# Enable YOLO mode (auto-approve all operations):
# OR_INTERN_YOLO=true

# ============================================================================
# Optional: External service tokens
# ============================================================================
# Slack bot token for notifications (if messaging.enabled in config.yaml):
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# MCP server tokens (if mcp_servers configured in config.yaml):
# MCP_SERVER_TOKEN=your-mcp-token
