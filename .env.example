# OR-Intern environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: LLM API key
OPENAI_API_KEY=your-api-key-here

# Optional: Custom API base URL (for OpenAI-compatible endpoints)
OPENAI_API_BASE=https://commander-deerflow-paas.apps.digiwincloud.com.cn/v1

# Optional: Override model name (default: openai/qwen3.6-plus)
OR_INTERN_MODEL=openai/qwen3.6-plus

# Optional: Override max iterations
# OR_INTERN_MAX_ITERATIONS=500

# Optional: YOLO mode (auto-approve all operations, for testing)
# OR_INTERN_YOLO=false
